# Copy to .env and fill in. Non-secret settings only: agents-cli deploy copies
# this file into the Cloud Run service's environment.

# Gmail account that sends the digest, and where it goes (often the same address)
GMAIL_ADDRESS=you@gmail.com
DIGEST_TO=you@gmail.com

# Use Gemini via an AI Studio API key (not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=False

# Optional
# DIGEST_TIMEZONE=America/Los_Angeles
# DIGEST_STATE_URI=gs://your-bucket/state   # set on Cloud Run; local runs use ./data
